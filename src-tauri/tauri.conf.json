{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "쌤비서",
  "mainBinaryName": "ssam",
  "version": "../package.json",
  "identifier": "kr.doguri.ssam",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "node scripts/copy-web.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "쌤비서",
        "width": 1280,
        "height": 860,
        "minWidth": 380,
        "minHeight": 560,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "doguri25",
    "copyright": "© 2026 도구리 (raccoon@ai.cne.go.kr)",
    "category": "Education",
    "shortDescription": "학교 업무 AI 비서: 평가·연수·계획·학급·품의",
    "longDescription": "평가·연수·계획·학급·품의 업무를 왼쪽 세로 메뉴 하나에 모으고, AI가 초안을 쓰면 교사는 확인·수정만 하는 Windows 앱(웹판 포함).",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Korean"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
